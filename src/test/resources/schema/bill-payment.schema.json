{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bill payment (GRAD-302)",
  "type": "object",
  "required": ["id", "receiptNo", "status", "biller", "subscriberNo", "amount", "fee", "total",
               "currency", "cardId", "balanceAfter", "createdAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^bpm_" },
    "receiptNo": { "type": "string", "pattern": "^RCP-[0-9]{8}-[0-9]{6}$" },
    "status": { "type": "string", "enum": ["SUCCESS"] },
    "biller": { "type": "object", "required": ["id", "name"] },
    "subscriberNo": { "type": "string" },
    "amount": { "type": "number" },
    "fee": { "type": "number", "minimum": 0 },
    "total": { "type": "number" },
    "currency": { "type": "string" },
    "cardId": { "type": "string", "pattern": "^vcd_" },
    "balanceAfter": { "type": "number", "minimum": 0 },
    "createdAt": { "type": "string" }
  }
}
