{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Virtual card (GRAD-201 / GRAD-202)",
  "type": "object",
  "required": ["id", "accountId", "label", "maskedPan", "expiry", "currency", "status",
               "availableBalance", "limits", "blockReason", "blockedAt", "createdAt", "spentToday"],
  "properties": {
    "id": { "type": "string", "pattern": "^vcd_" },
    "accountId": { "type": "string" },
    "label": { "type": ["string", "null"] },
    "maskedPan": { "type": "string", "pattern": "^4169 73[*]{2} [*]{4} [0-9]{4}$" },
    "expiry": { "type": "string", "pattern": "^(0[1-9]|1[0-2])/[0-9]{2}$" },
    "currency": { "type": "string", "enum": ["AZN", "USD", "EUR"] },
    "status": { "type": "string", "enum": ["ACTIVE", "FROZEN", "BLOCKED"] },
    "availableBalance": { "type": "number", "minimum": 0 },
    "limits": {
      "type": "object",
      "required": ["dailyOnline", "perTransaction"],
      "properties": {
        "dailyOnline": { "type": "number" },
        "perTransaction": { "type": "number" }
      }
    },
    "blockReason": { "type": ["string", "null"] },
    "blockedAt": { "type": ["string", "null"] },
    "createdAt": { "type": "string" },
    "spentToday": { "type": "number", "minimum": 0 }
  }
}
