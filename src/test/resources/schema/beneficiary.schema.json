{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Beneficiary (GRAD-101)",
  "type": "object",
  "required": ["id", "fullName", "iban", "ibanMasked", "currency", "nickname", "createdAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^ben_[a-z0-9]{8}$" },
    "fullName": { "type": "string", "minLength": 2, "maxLength": 50 },
    "iban": { "type": "string", "pattern": "^AZ[0-9]{2}[A-Z]{4}[A-Z0-9]{20}$" },
    "ibanMasked": { "type": "string" },
    "currency": { "type": "string", "enum": ["AZN", "USD", "EUR"] },
    "nickname": { "type": ["string", "null"], "maxLength": 20 },
    "createdAt": { "type": "string" }
  }
}
