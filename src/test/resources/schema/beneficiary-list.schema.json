{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Beneficiary list (GRAD-102)",
  "type": "object",
  "required": ["total", "items"],
  "properties": {
    "total": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fullName", "iban", "ibanMasked", "currency", "nickname", "createdAt"],
        "properties": {
          "id": { "type": "string", "pattern": "^ben_" },
          "currency": { "type": "string", "enum": ["AZN", "USD", "EUR"] }
        }
      }
    }
  }
}
