{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Billers catalog (GRAD-301)",
  "type": "object",
  "required": ["total", "items"],
  "properties": {
    "total": { "type": "integer" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "subscriberPattern", "minAmount", "maxAmount", "fee"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string", "enum": ["UTILITY", "MOBILE", "INTERNET"] },
          "subscriberPattern": { "type": "string" },
          "minAmount": { "type": "number" },
          "maxAmount": { "type": "number" },
          "fee": { "type": "object", "required": ["type"] }
        }
      }
    }
  }
}
